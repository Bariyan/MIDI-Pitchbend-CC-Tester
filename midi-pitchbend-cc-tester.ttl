@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<urn:bariyan:midi-pitchbend-cc-tester>
    a lv2:Plugin ;
    doap:name "EWI MIDI Tester" ;
    doap:maintainer [ foaf:name "Atsushi Nishihata(Bariyan)" ] ;
    lv2:requiredFeature urid:map ;

    lv2:port
    [ 
        a lv2:OutputPort , atom:AtomPort ;
        lv2:index 0 ;
        lv2:symbol "out" ;
        lv2:name "MIDI Out" ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:minimumSize 2048 ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ;
        lv2:symbol "enable" ;
        lv2:name "Enable (Note On/Off)" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "interval_ms" ;
        lv2:name "CC/PB Interval(ms)" ;
        lv2:default 20 ;
        lv2:minimum 1 ;
        lv2:maximum 2000 ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "channel" ;
        lv2:name "MIDI Channel" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "note_number" ;
        lv2:name "Note Number" ;
        lv2:default 60 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "velocity" ;
        lv2:name "Velocity" ;
        lv2:default 64 ;
        lv2:minimum 1 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "pb_value" ;
        lv2:name "Pitch Bend Value" ;
        lv2:default 0 ;
        lv2:minimum -8192 ;
        lv2:maximum 8191 ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "cc_breath" ;
        lv2:name "Breath (CC #2)" ;
        lv2:default 100 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "cc_expression" ;
        lv2:name "Expression (CC #11)" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "cc_modulation" ;
        lv2:name "Modulation (CC #1)" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "cc_extra_num" ;
        lv2:name "Extra CC Number" ;
        lv2:default 7 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ],
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "cc_extra_val" ;
        lv2:name "Extra CC Value" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 127 ;
        lv2:portProperty lv2:integer ;
    ] .